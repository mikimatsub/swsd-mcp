{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "tools": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "required": [
    "name",
    "version",
    "tools"
  ],
  "additionalProperties": false
}
