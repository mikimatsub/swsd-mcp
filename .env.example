# === Required (stdio transport) ===

# Your SolarWinds Service Desk API token (JWT).
# Required for stdio mode. For http mode, the token is per-request via the
# Authorization or X-SWSD-Token header instead: see README "HTTP transport".
SWSD_TOKEN=

# === SWSD endpoint configuration ===

# Regional SWSD API base URL.
#   US tenants: https://api.samanage.com (default)
#   EU tenants: https://apieu.samanage.com
# SECURITY: must use HTTPS on samanage.com without embedded credentials.
# Other URLs are rejected at startup to prevent SSRF if the env var ever gets
# user-influenced.
SWSD_BASE_URL=https://api.samanage.com

# SWSD API version. Defaults to v2.1 (current). Override only if your tenant
# requires v1.1 or another version (rare).
SWSD_API_VERSION=v2.1

# === Server behavior ===

# Transport: stdio (default, for local agent clients) or http (for hosted /
# Copilot Studio).
SWSD_TRANSPORT=stdio

# Profile: triage, agent, knowledge, operations, or custom. Determines the set
# of tools registered at startup.
SWSD_PROFILE=agent

# Custom selection (SWSD_PROFILE=custom): CSV and/or a local JSON profile.
# Both sources are unioned; unknown tool names warn and are skipped.
# SWSD_TOOLS=swsd_get_server_info,swsd_list_incidents
# SWSD_PROFILE_FILE=./profiles/desk.json
SWSD_TOOLS=
SWSD_PROFILE_FILE=

# Write mode: live (default), dry-run, or disabled.
# dry-run returns the write request payload without calling SWSD; disabled
# rejects write tools. Read-only tools are unaffected.
SWSD_WRITE_MODE=live

# Optional filesystem boundary for stdio attachment uploads. When set,
# swsd_upload_attachment accepts file_path only when its resolved real path is
# inside this directory. Leave empty to preserve unrestricted local stdio file
# uploads. Has no effect on content_base64 or HTTP transport.
SWSD_ATTACHMENT_ROOT=

# Comma-separated extra tool names to enable on top of the profile.
# Unknown names cause a startup error (loud-fail by design).
# Delete tools require operations or explicit selection in a custom profile.
# Example: SWSD_ENABLE_EXTRAS=swsd_create_incident,swsd_update_incident
SWSD_ENABLE_EXTRAS=

# === HTTP transport only ===

# Listen port. Default 3000.
PORT=3000

# Comma-separated allowed Origin headers. Empty allows only HTTP(S) origins on
# localhost, 127.0.0.1 or [::1], with any port. Requests without Origin are allowed.
SWSD_ALLOWED_ORIGINS=

# Optional comma-separated exact Host headers, including ports when present
# (e.g., mcp.example.test,localhost:3000). Empty disables Host validation.
# Does not change the listen address. Set for DNS rebinding protection on hosts.
SWSD_ALLOWED_HOSTS=

# Express trust-proxy setting. Tells Express how many proxy hops to trust
# when computing req.ip (used for rate-limit keying).
#   false (default): no proxy; req.ip = direct client IP
#   true: trust all proxies (only safe behind a fully-trusted edge)
#   1: trust the immediate proxy (typical for Azure App Service, Nginx, etc.)
#   2: trust two hops (e.g., Cloudflare → App Service)
#   "loopback" or specific IPs: trust by source
# Set to 1 when deploying behind Azure App Service or any standard reverse proxy.
SWSD_TRUST_PROXY=

# Rate limit on /mcp (per token+IP, sha256-hashed). /healthz is excluded.
# Defaults: 100 requests per 60-second window. Tighten or loosen for your
# usage pattern. Returns 429 with standard rate-limit headers when exceeded.
SWSD_RATE_LIMIT_WINDOW_MS=60000
SWSD_RATE_LIMIT_MAX=100

# === Reliability ===

# Max retry attempts for retryable errors (5xx and network failures on GETs).
SWSD_RETRY_MAX_ATTEMPTS=3

# Per-request timeout for outbound SWSD calls. If a call hangs, it's aborted
# and retried (for GET only) or surfaced as a network error (all other methods).
# Default: 30 seconds. Range: 1s to 5min.
SWSD_REQUEST_TIMEOUT_MS=30000

# Largest file swsd_get_incident_attachment returns, in bytes. Larger files are refused.
# Default: 5 MB.
SWSD_MAX_ATTACHMENT_BYTES=5242880
